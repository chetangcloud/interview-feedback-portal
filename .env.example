# ---------------------------------------------------------------
# Interview Feedback Portal — environment configuration
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------

# PostgreSQL connection string.
# Matches the docker-compose.yml service (db) exposed on host port 5433.
DATABASE_URL="postgresql://interview:interview@localhost:5433/interview_feedback?schema=public"

# Anthropic API key, used ONLY on the backend to generate the final
# AI interview summary. Never exposed to the frontend. Leave empty
# to run the AI summary endpoint in a graceful "unavailable" state.
ANTHROPIC_API_KEY=

# Model used for the AI interview summary.
ANTHROPIC_MODEL=claude-sonnet-4-5
